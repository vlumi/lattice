<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store requires App Sandbox. Nothing else yet: no network,
	     no file access — Nearby play adds its entitlements when it lands. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
