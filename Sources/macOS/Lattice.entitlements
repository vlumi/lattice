<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store requires App Sandbox. Nearby play adds its network
	     entitlements when it lands. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Save the share-card PNG where the user chooses (.fileExporter —
	     with read-only, the save panel silently no-ops). -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Universal Links for challenge codes — see the iOS entitlements. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:lattice.misaki.fi</string>
	</array>
	<!-- iCloud Key-Value Storage for opt-in cross-device sync (bests +
	     daily log — a tiny Codable blob; no CloudKit container). The
	     identifier is pinned EXPLICITLY and is IDENTICAL on iOS + macOS so
	     the two apps share one store; without this they'd derive separate
	     stores from the (shared) bundle id and never see each other. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)fi.misaki.lattice</string>
	<!-- Nearby duel (MultipeerConnectivity/Bonjour): the sandbox needs both
	     directions to advertise and browse on the local network. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
